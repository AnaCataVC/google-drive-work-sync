<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoogleDriveWorkSync.Views.WorkSyncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GoogleDriveWorkSync.Models"
    xmlns:vm="using:GoogleDriveWorkSync.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Spacing="6">
                <TextBlock Text="Sincronización de Archivos de Trabajo" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Copia de seguridad incremental por hash SHA-256 hacia Google Drive con subida por lotes."
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" MaxWidth="860" HorizontalAlignment="Left">

                <!-- Main Status Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Top status row -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="Estado del Respaldo" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.DriveSyncFoldersDisplay, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DriveSyncStatusText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Section -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsDriveSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{x:Bind ViewModel.DriveSyncProgress, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.DriveSyncDetailText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Sync Errors Banner -->
                        <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10"
                                Visibility="{x:Bind ViewModel.HasSyncErrors, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="16"/>
                                    <TextBlock Text="{x:Bind ViewModel.SyncErrorsButtonText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="Ver detalles" Click="ShowSyncErrorsDialog_Click"
                                            Padding="10,4" FontSize="12"/>
                                    <Button Content="Reintentar errores" Command="{x:Bind ViewModel.RetrySyncErrorsCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsDriveSyncing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="10,4" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Controls Row -->
                        <Grid Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Último respaldo:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.DriveSyncLastSyncText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Command="{x:Bind ViewModel.OpenDriveFolderCommand}"
                                        Visibility="{x:Bind ViewModel.IsDriveSyncConfigured, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                        <TextBlock Text="Abrir Drive" />
                                    </StackPanel>
                                </Button>

                                <Button Content="Cancelar" Command="{x:Bind ViewModel.CancelDriveSyncCommand}"
                                        Visibility="{x:Bind ViewModel.IsDriveSyncing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- PRIMARY ACTION: Sync only new or modified (Incremental default) -->
                                <Button Command="{x:Bind ViewModel.SyncDriveNowCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsDriveSyncing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE753;" FontSize="14"/>
                                        <TextBlock Text="Sincronizar desincronizados" />
                                    </StackPanel>
                                </Button>

                                <!-- Secondary options dropdown -->
                                <Button Visibility="{x:Bind ViewModel.IsDriveSyncing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Padding="8,6">
                                    <FontIcon Glyph="&#xE712;" FontSize="13"/>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Ver qué falta por sincronizar"
                                                            Command="{x:Bind ViewModel.PreviewOutOfSyncCommand}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE71C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Forzar sincronización total (Re-subir todo)"
                                                            Command="{x:Bind ViewModel.ForceSyncDriveCommand}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE72C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
