<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoogleDriveWorkSync.Views.RestoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GoogleDriveWorkSync.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Restaurar desde Google Drive" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Descarga archivos respaldados a su carpeta original o a otra carpeta. Requiere la versión actual del script de Apps Script."
                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.ListRemoteFilesCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsListing, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsListing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Width="16" Height="16" />
                    <FontIcon Glyph="&#xE753;" FontSize="13"
                              Visibility="{x:Bind ViewModel.IsListing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <TextBlock Text="Listar archivos en Drive" />
                </StackPanel>
            </Button>

            <TextBox Grid.Column="1" PlaceholderText="Filtrar por ruta o estado..."
                     Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Seleccionar todo" Command="{x:Bind ViewModel.SelectAllCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <Button Content="Ninguno" Command="{x:Bind ViewModel.SelectNoneCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Destination options -->
        <StackPanel Grid.Row="2" Spacing="8">
            <ToggleSwitch Header="Sobrescribir archivos existentes (el actual va a la Papelera de reciclaje)"
                          IsOn="{x:Bind ViewModel.OverwriteExisting, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Restaurar en otra carpeta…" Click="ChooseAlternateRootButton_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <Button Content="Usar carpetas originales" Command="{x:Bind ViewModel.ClearAlternateRootCommand}"
                        Visibility="{x:Bind ViewModel.HasAlternateRoot, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.AlternateRootDisplay, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Plan list -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.VisibleItems}" SelectionMode="None"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RestorePlanItem">
                    <Grid ColumnSpacing="12" Padding="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  IsEnabled="{x:Bind CanSelect}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind DriveRelativePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind LocalTargetDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind StatusText}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind FormattedSize}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Restore + progress -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancelar" Command="{x:Bind ViewModel.CancelRestoreCommand}"
                    Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Grid.Column="2" Content="Restaurar seleccionados" Style="{StaticResource AccentButtonStyle}"
                    Click="RestoreSelectedButton_Click" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
