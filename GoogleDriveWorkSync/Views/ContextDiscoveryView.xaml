<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GoogleDriveWorkSync.Views.ContextDiscoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GoogleDriveWorkSync.Models"
    xmlns:vm="using:GoogleDriveWorkSync.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ListView ItemsSource="{x:Bind ViewModel.GroupedCandidates, Mode=OneWay}" SelectionMode="None" Padding="36,24,36,36">
        <ListView.Header>
            <StackPanel Spacing="16" Margin="0,0,0,16">
                <!-- Header -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Respaldo de Contexto IA (Claude)" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Localiza CLAUDE.md, references, skills, agentes, hooks y memorias con filtrado multi-capa de secretos y detección de Git."
                               Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Configuration and Search Bar -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0" Header="Directorio raíz a explorar"
                                     Text="{x:Bind ViewModel.TargetDirectory, Mode=TwoWay}" />
                            <NumberBox Grid.Column="1" Header="Profundidad"
                                       Value="{x:Bind ViewModel.MaxDepth, Mode=TwoWay}" SmallChange="1" Minimum="1" Maximum="6" Width="120" />
                            <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.DiscoverCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" />
                                    <TextBlock Text="Explorar" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="16" Height="16" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions & Sync Panel -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                            <!-- PRIMARY ACTION: Sincronizar desincronizados -->
                            <Button Grid.Column="0"
                                    Command="{x:Bind ViewModel.SyncToDriveCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanSyncToDrive, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SyncButtonToolTip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE753;" />
                                    <TextBlock Text="{x:Bind ViewModel.SyncButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary options dropdown -->
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,6"
                                    Visibility="{x:Bind ViewModel.IsSyncingToDrive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE712;" FontSize="13"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="Ver qué falta por sincronizar"
                                                        Command="{x:Bind ViewModel.PreviewOutOfSyncCandidatesCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Forzar sincronización total a Drive"
                                                        Command="{x:Bind ViewModel.ForceSyncAllToDriveCommand}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Command="{x:Bind ViewModel.CancelDriveSyncCommand}"
                                    Visibility="{x:Bind ViewModel.IsSyncingToDrive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" />
                                    <TextBlock Text="Cancelar" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.DriveSyncStatusMessage, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastSyncDisplay, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.IsSyncingToDrive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.DriveSyncCurrentCount, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{x:Bind ViewModel.DriveSyncTotalCount, Mode=OneWay}" />
                                <Run Text="archivos" />
                            </TextBlock>
                        </Grid>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsSyncingToDrive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{x:Bind ViewModel.DriveSyncProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" />
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DriveSyncProgressDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DriveSyncProgressPercentageText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>

                        <!-- Quick Selection Filters -->
                        <Grid ColumnDefinitions="Auto, *">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Solo desincronizados" Command="{x:Bind ViewModel.SelectOnlyOutOfSyncCommand}" />
                                <Button Content="Seleccionar todo" Command="{x:Bind ViewModel.SelectAllCommand}" />
                                <Button Content="Deseleccionar todo" Command="{x:Bind ViewModel.DeselectAllCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ListView.Header>

        <!-- Candidate Categories Groups -->
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:CandidateGroup">
                <Expander Margin="0,4,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*, Auto, Auto" HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0" Text="{x:Bind Category}" VerticalAlignment="Center"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Margin="0,0,8,0" Tag="{x:Bind}" Click="SelectAllInGroup_Click">
                                <TextBlock Text="Seleccionar todo" />
                            </Button>
                            <Button Grid.Column="2" Tag="{x:Bind}" Click="DeselectAllInGroup_Click">
                                <TextBlock Text="Ninguno" />
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <ItemsControl ItemsSource="{x:Bind}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ClaudeDiscoveryCandidate">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" Padding="8,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12">
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind RelativePath}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FilePath}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusBadge}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{x:Bind SizeDisplay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
